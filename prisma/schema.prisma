generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  role             Role      @default(USER)
  bio              String?
  avatarUrl        String?
  skillsOffered    String[]  @default([])
  skillsWanted     String[]  @default([])
  xp               Int       @default(0)
  level            Int       @default(1)
  badges           Badge[]   @relation("UserBadges")
  plan             Plan?     @relation(fields: [planId], references: [id])
  planId           String?
  projects         Project[]
  submissions      Submission[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Course {
  id           String   @id @default(uuid())
  title        String
  skill        String
  level        String
  description  String?
  lessons      Lesson[]
  finalProject Json?
  createdAt    DateTime @default(now())
}

model Lesson {
  id           String   @id @default(uuid())
  course       Course   @relation(fields: [courseId], references: [id])
  courseId     String
  title        String
  content      String?  // markdown
  videoUrl     String?
  durationMin  Int?
  quiz         Quiz?
  quizId       String?
  order        Int      @default(0)
}

model Quiz {
  id        String   @id @default(uuid())
  questions Json
}

model Challenge {
  id          String   @id @default(uuid())
  title       String
  skill       String
  brief       String
  deliverables String[]
  rubric      Json
  autoChecks  String[] @default([])
  createdAt   DateTime @default(now())
}

model Submission {
  id           String   @id @default(uuid())
  challenge    Challenge @relation(fields: [challengeId], references: [id])
  challengeId  String
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  files        Json?
  repoUrl      String?
  answers      Json?
  score        Float?
  status       SubmissionStatus @default(PENDING)
  feedback     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  title       String
  description String
  tags        String[]
  images      String[]
  deployedUrl String?
  repoUrl     String?
  badges      String[] @default([])
  createdAt   DateTime @default(now())
}

model Opportunity {
  id           String   @id @default(uuid())
  title        String
  org          String
  type         String
  description  String
  requirements String[]
  isPremium    Boolean  @default(false)
  postedAt     DateTime @default(now())
}

model Match {
  id        String  @id @default(uuid())
  type      String
  userAId   String
  userBId   String
  score     Float
  status    String
  createdAt DateTime @default(now())
}

model Badge {
  id    String @id @default(uuid())
  name  String
  users User[] @relation("UserBadges")
}

model Plan {
  id          String   @id
  name        String
  priceMonthly Int
  currency    String
  features    String[] @default([])
  limits      Json?
}

enum Role {
  USER
  MENTOR
  EMPLOYER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  AUTO_CHECKED
  PEER_REVIEW
  ACCEPTED
  REJECTED
}

// Ads models
model Ad {
  id             String   @id @default(uuid())
  title          String
  advertiserName String
  imageUrl       String?
  targetUrl      String
  cpm            Int       // stored in currency's minor unit (e.g., kobo)
  slot           Int       // 1..3 (slot position preference)
  isNative       Boolean   @default(false)
  frequencyCap   Int?      // e.g., max impressions per user per day
  isActive       Boolean  @default(false)
  approvedById   String?
  startAt        DateTime?
  endAt          DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  impressions    AdImpression[]
  clicks         AdClick[]
}

model AdImpression {
  id        String   @id @default(uuid())
  ad        Ad       @relation(fields: [adId], references: [id])
  adId      String
  userId    String?  // nullable, for logged-in anonymized mapping
  sessionId String?  // optional
  ipHash    String?  // store hashed ip for dedupe (not raw)
  counted   Boolean  @default(false) // only true when counted as billable (viewable)
  createdAt DateTime @default(now())
}

model AdClick {
  id        String   @id @default(uuid())
  ad        Ad       @relation(fields: [adId], references: [id])
  adId      String
  userId    String?
  ipHash    String?
  createdAt DateTime @default(now())
}
