import React, { useEffect, useRef, useState } from 'react'

type Ad = { id: string; title: string; advertiserName: string; imageUrl?: string; targetUrl: string; isNative?: boolean }

export default function AdSlot({ slot } : { slot: number }) {
  const [ad, setAd] = useState<Ad|null>(null)
  const ref = useRef<HTMLDivElement|null>(null)
  const [sent, setSent] = useState(false)

  useEffect(() => {
    async function loadAd(){
      const res = await fetch(`/api/ads?slot=${slot}`)
      const data = await res.json()
      if (data?.ad) setAd(data.ad)
    }
    loadAd()
  }, [slot])

  useEffect(() => {
    if (!ad || sent) return
    let visibleMs = 0
    let timer: number | null = null

    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting && e.intersectionRatio >= 0.5) {
          timer = window.setInterval(() => {
            visibleMs += 200
            if (visibleMs >= 1000 && !sent) {
              fetch(`/api/ads/${ad.id}/impression`, {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ visibilityMs: visibleMs, percentVisible: Math.round(e.intersectionRatio*100) })
              }).finally(()=> setSent(true))
              if (timer) { clearInterval(timer); timer = null }
            }
          }, 200)
        } else {
          if (timer) { clearInterval(timer); timer = null }
          visibleMs = 0
        }
      })
    }, { threshold: [0,0.5,1] })

    if (ref.current) obs.observe(ref.current)
    return () => { if (timer) clearInterval(timer); obs.disconnect() }
  }, [ad, sent])

  if (!ad) return null

  return (
    <div ref={ref} className="ad-slot border rounded p-2 bg-white">
      <div className="text-xs text-gray-500">Sponsored • {ad.advertiserName}</div>
      {ad.imageUrl ? (
        <a href={`/api/ads/${ad.id}/click`} target="_blank" rel="noopener noreferrer">
          <img src={ad.imageUrl} alt={ad.title} className="w-full h-auto" />
        </a>
      ) : (
        <a href={`/api/ads/${ad.id}/click`} className="block text-blue-600">{ad.title}</a>
      )}
    </div>
  )
}
