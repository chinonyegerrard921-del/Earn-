const { PrismaClient } = require('@prisma/client')
const fs = require('fs')
const path = require('path')

const prisma = new PrismaClient()

async function seed(){
  const seedPath = path.join(process.cwd(),'seed','data.seed.json')
  if (!fs.existsSync(seedPath)) {
    console.error('seed/data.seed.json not found')
    process.exit(1)
  }
  const data = JSON.parse(fs.readFileSync(seedPath,'utf8'))

  // Upsert plans
  if (data.pricingPlans) {
    for (const p of data.pricingPlans){
      await prisma.plan.upsert({
        where: { id: p.id },
        update: { name: p.name, priceMonthly: p.priceMonthly, currency: p.currency, features: p.features, limits: p.limits },
        create: { id: p.id, name: p.name, priceMonthly: p.priceMonthly, currency: p.currency, features: p.features, limits: p.limits }
      })
      console.log('Upserted plan', p.id)
    }
  }

  // Upsert ads if present
  if (data.ads) {
    for (const a of data.ads){
      await prisma.ad.upsert({
        where: { id: a.id },
        update: {
          title: a.title,
          advertiserName: a.advertiserName,
          imageUrl: a.imageUrl,
          targetUrl: a.targetUrl,
          cpm: a.cpm,
          slot: a.slot,
          isNative: a.isNative,
          frequencyCap: a.frequencyCap,
          isActive: a.isActive
        },
        create: {
          id: a.id,
          title: a.title,
          advertiserName: a.advertiserName,
          imageUrl: a.imageUrl,
          targetUrl: a.targetUrl,
          cpm: a.cpm,
          slot: a.slot,
          isNative: a.isNative,
          frequencyCap: a.frequencyCap,
          isActive: a.isActive
        }
      })
      console.log('Upserted ad', a.id)
    }
  }

  console.log('Seeding complete')
  await prisma.$disconnect()
}

seed().catch(err=>{ console.error(err); prisma.$disconnect(); process.exit(1) })
EOF

# scripts/aggregateAds.js
ensure_dir "scripts/aggregateAds.js"
cat > scripts/aggregateAds.js <<'EOF'
const { PrismaClient } = require('@prisma/client')
const fs = require('fs')
const path = require('path')

const prisma = new PrismaClient()

async function aggregateForDate(dateStr){
  const date = dateStr ? new Date(dateStr) : new Date()
  date.setDate(date.getDate() - 1)
  const start = new Date(date)
  start.setUTCHours(0,0,0,0)
  const end = new Date(date)
  end.setUTCHours(23,59,59,999)

  console.log(`Aggregating ad impressions for ${start.toISOString().slice(0,10)}`)

  const ads = await prisma.ad.findMany()
  const rows = []
  rows.push('adId,adTitle,billableImpressions,clicks,earnings_ngn')

  for (const ad of ads){
    const countImpr = await prisma.adImpression.count({ where: { adId: ad.id, counted: true, createdAt: { gte: start, lte: end } } })
    const countClicks = await prisma.adClick.count({ where: { adId: ad.id, createdAt: { gte: start, lte: end } } })
    const earningsKobo = Math.round((countImpr / 1000) * (ad.cpm || 0))
    const earningsNgn = (earningsKobo / 100).toFixed(2)
    rows.push(`${ad.id},"${(ad.title||'').replace(/"/g,'""')}",${countImpr},${countClicks},${earningsNgn}`)
  }

  const outDir = path.join(process.cwd(),'tmp')
  if (!fs.existsSync(outDir)) fs.mkdirSync(outDir)
  const outPath = path.join(outDir, `ads_aggregation_${start.toISOString().slice(0,10)}.csv`)
  fs.writeFileSync(outPath, rows.join('\n'))
  console.log('Wrote', outPath)
  await prisma.$disconnect()
}

const arg = process.argv[2]
aggregateForDate(arg).catch(err=>{ console.error(err); prisma.$disconnect(); process.exit(1) })
EOF

