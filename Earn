import type { NextApiRequest, NextApiResponse } from 'next'
import { prisma } from '../../../lib/prisma'

export default async function handler(req: NextApiRequest, res: NextApiResponse) {
  const { slot } = req.query
  if (!slot) return res.status(400).json({ error: 'slot required' })
  const slotNum = parseInt(Array.isArray(slot) ? slot[0] : slot, 10)
  const now = new Date()
  try {
    const ad = await prisma.ad.findFirst({
      where: {
        slot: slotNum,
        isActive: true,
        AND: [
          {
            OR: [
              { startAt: null },
              { startAt: { lte: now } }
            ]
          },
          {
            OR: [
              { endAt: null },
              { endAt: { gte: now } }
            ]
          }
        ]
      },
      orderBy: { createdAt: 'desc' }
    })

    if (!ad) return res.status(200).json({ ad: null })

    // sanitize response: don't send CPM to clients
    const { cpm, ...sanitized } = ad as any
    res.status(200).json({ ad: sanitized })
  } catch (err) {
    console.error(err)
    res.status(500).json({ error: 'internal' })
  }
}
