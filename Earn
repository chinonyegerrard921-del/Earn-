import type { NextApiRequest, NextApiResponse } from 'next'
import { prisma } from '../../../../lib/prisma'

export default async function handler(req: NextApiRequest, res: NextApiResponse) {
  const { id } = req.query
  if (!id || Array.isArray(id)) return res.status(400).json({ error: 'invalid id' })
  if (req.method !== 'POST') return res.status(405).json({ error: 'method not allowed' })

  const { userId, sessionId, visibilityMs, percentVisible, ipHash } = req.body
  const adId = id
  const visibility = Number(visibilityMs || 0)
  const percent = Number(percentVisible || 0)

  try {
    const ad = await prisma.ad.findUnique({ where: { id: adId as string } })
    if (!ad) return res.status(404).json({ error: 'ad not found' })

    // viewability rule: >=1000ms && >=50% visible
    let counted = false
    if (visibility >= 1000 && percent >= 50) counted = true

    // frequency cap enforcement (per-user per-day) if userId and ad.frequencyCap
    if (counted && userId && ad.frequencyCap) {
      const start = new Date()
      start.setUTCHours(0,0,0,0)
      const end = new Date()
      end.setUTCHours(23,59,59,999)
      const todaysCount = await prisma.adImpression.count({
        where: { adId: adId as string, userId: userId as string, counted: true, createdAt: { gte: start, lte: end } }
      })
      if (todaysCount >= ad.frequencyCap) counted = false
    }

    const imp = await prisma.adImpression.create({
      data: {
        adId: adId as string,
        userId: userId || null,
        sessionId: sessionId || null,
        ipHash: ipHash || null,
        counted
      }
    })

    res.status(200).json({ success: true, counted })
  } catch (err) {
    console.error(err)
    res.status(500).json({ error: 'internal' })
  }
}
